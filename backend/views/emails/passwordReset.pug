extends baseEmail

block content
  p Hi #{firstName},
  p Forgot your password? No problem! Click the button below to reset your password:
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset Your Password
  p This link will expire in 10 minutes for security reasons.
  p If you didn't request a password reset, please ignore this email - your password will remain unchanged.
